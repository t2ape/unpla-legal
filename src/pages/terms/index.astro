---
import { render } from 'astro:content';
import LegalLayout from '../../layouts/LegalLayout.astro';
import { getVersions, pickCurrent } from '../../lib/entries';

// 常に最新版（status: current）を返すエイリアス。
const entries = await getVersions('terms');
const current = pickCurrent(entries);
const { Content, headings } = await render(current);
---

<LegalLayout kind="terms" entry={current} entries={entries} headings={headings} isAlias={true}>
  <Content />
</LegalLayout>
