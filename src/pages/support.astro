---
// サポートページ（App Store Connect の「サポート URL」に登録する安定 URL）。
// 問い合わせフォームは設けず、連絡先メールと基本的な案内のみを掲載する静的ページ。
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCommerce } from '../lib/entries';
import { KIND_LABEL, PATHS } from '../utils';

const supportEmail = 'support@unpla.app';
// Apple は特商法の表示を「アプリ内かサポートサイト」に求めるので、ここから辿れるようにする。
const commerce = await getCommerce();
const links = [
  { href: PATHS.terms, label: KIND_LABEL.terms },
  { href: PATHS.privacy, label: KIND_LABEL.privacy },
  ...(commerce ? [{ href: PATHS.commerce, label: commerce.data.title }] : []),
];
---

<BaseLayout pageTitle="サポート" path={PATHS.support}>
  <div class="container narrow">
    <header class="page-hero">
      <span class="eyebrow">Support</span>
      <h1>サポート</h1>
      <p class="lead">
        アンプラクエスト（UnplaQuest）に関するご質問・不具合のご連絡は、メールで受け付けています。
      </p>
    </header>

    <section class="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading">お問い合わせ先</h2>
      <a class="mail-button" href={`mailto:${supportEmail}`}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M4 6h16v12H4zM4 7l8 6 8-6"></path>
        </svg>
        {supportEmail}
      </a>
      <ul class="tips">
        <li>いただいたお問い合わせには順次対応します。返信までお時間をいただく場合があります。</li>
        <li>ご利用の端末・iOS のバージョンと、起きている状況をあわせてお知らせいただくとスムーズです。</li>
      </ul>
    </section>

    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">関連情報</h2>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>
                {link.label}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .narrow {
    max-width: 46rem;
  }
  h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    margin: 0 0 1rem;
  }
  .contact {
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .mail-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--surface);
    font-weight: 600;
    text-decoration: none;
    word-break: break-all;
    transition: background 0.15s ease;
  }
  .mail-button:hover {
    background: var(--accent-strong);
    color: var(--surface);
  }
  .mail-button svg {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tips {
    margin: 1.25rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .tips li + li {
    margin-top: 0.35rem;
  }
  .related {
    margin-top: 3rem;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
  }
  .related li + li {
    border-top: 1px solid var(--border);
  }
  .related a {
    display: flex;
    justify-content: space-between;
    padding: 0.85rem 1.15rem;
    color: var(--text);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .related a:hover {
    background: var(--surface-muted);
  }
  .related a span {
    color: var(--text-faint);
  }
</style>
