---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCommerce } from '../../lib/entries';
import { COMMERCE_PATH, formatDate } from '../../utils';

// 特定商取引法に基づく表示（/tokushoho）。本文は src/content/commerce/index.md。
// 下書きの間は本番ビルドでページを生成しないため、生成数を 0 にできる動的ルートにしている
// （静的ルートでは getStaticPaths が無視される）。path は常に undefined で /tokushoho だけを作る。
export const getStaticPaths = (async () => {
  const entry = await getCommerce();
  return entry ? [{ params: { path: undefined }, props: { entry } }] : [];
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, updatedDate, status } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout pageTitle={title} breadcrumb={title} path={COMMERCE_PATH}>
  <header class="doc-header">
    <h1>{title}</h1>
    <p class="meta">最終更新日：{formatDate(updatedDate)}</p>
  </header>

  {
    status === 'draft' && (
      <aside class="notice draft" role="note">
        下書きです。開発サーバでだけ表示され、本番には公開されません。
      </aside>
    )
  }

  <article class="doc-body">
    <Content />
  </article>
</BaseLayout>
