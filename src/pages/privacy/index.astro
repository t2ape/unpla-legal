---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { getVersions, pickCurrent, renderEntry } from '../../lib/entries';

// 常に最新版（status: current）を返すエイリアス。
const entries = await getVersions('privacy');
const current = pickCurrent(entries);
const { Content, headings } = await renderEntry(current);
---

<LegalLayout kind="privacy" entry={current} entries={entries} headings={headings} isAlias={true}>
  <Content />
</LegalLayout>
