---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCommerce, getVersions, pickCurrent } from '../lib/entries';
import { COMMERCE_PATH, FAQ_PATH, formatDate } from '../utils';

// リンクハブ：各ドキュメントの最新版へ誘導する。
const terms = pickCurrent(await getVersions('terms'));
const privacy = pickCurrent(await getVersions('privacy'));
const commerce = await getCommerce();

const cards = [
  {
    href: '/terms',
    eyebrow: 'Terms of Service',
    title: terms.data.title,
    meta: `第${terms.data.version}版・効力発生日 ${formatDate(terms.data.effectiveDate)}`,
    icon: 'doc',
  },
  {
    href: '/privacy',
    eyebrow: 'Privacy Policy',
    title: privacy.data.title,
    meta: `第${privacy.data.version}版・効力発生日 ${formatDate(privacy.data.effectiveDate)}`,
    icon: 'shield',
  },
  ...(commerce
    ? [
        {
          href: COMMERCE_PATH,
          eyebrow: 'Commercial Disclosure',
          title: commerce.data.title,
          meta: `最終更新日 ${formatDate(commerce.data.updatedDate)}`,
          icon: 'receipt',
        },
      ]
    : []),
  {
    href: FAQ_PATH,
    eyebrow: 'FAQ',
    title: 'よくある質問',
    meta: 'ブロックが外せない・効かないときの対処など',
    icon: 'question',
  },
  {
    href: '/support',
    eyebrow: 'Support',
    title: 'サポート',
    meta: 'お問い合わせ・不具合のご連絡',
    icon: 'mail',
  },
];

// 線だけの簡素なアイコン（24px グリッド）。
const ICONS: Record<string, string> = {
  doc: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6',
  shield: 'M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6zM9 12l2 2 4-4',
  receipt: 'M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6M9 16h3',
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
  question: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17h.01',
};
---

<BaseLayout path="/">
  <div class="container">
    <header class="page-hero hub-hero">
      <span class="eyebrow">Legal</span>
      <h1>UnplaQuest 法務情報</h1>
      <p class="lead">
        アンプラクエスト（UnplaQuest）をご利用いただくうえでの約束ごとと、情報の取り扱いについてまとめています。
      </p>
    </header>

    <ul class="cards">
      {
        cards.map((card) => (
          <li>
            <a class="card" href={card.href}>
              <span class="card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <path d={ICONS[card.icon]} />
                </svg>
              </span>
              <span class="card-body">
                <span class="card-eyebrow">{card.eyebrow}</span>
                <span class="card-title">{card.title}</span>
                <span class="card-meta">{card.meta}</span>
              </span>
              <span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .hub-hero {
    padding-top: 4rem;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    max-width: 42rem;
  }
  .card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    height: 100%;
    padding: 1.35rem 1.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .card:hover {
    color: var(--text);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .card-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .card-icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }
  .card-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .card-meta {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .card-arrow {
    align-self: center;
    color: var(--text-faint);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }
  .card:hover .card-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-arrow {
      transition: none;
    }
    .card:hover,
    .card:hover .card-arrow {
      transform: none;
    }
  }
</style>
