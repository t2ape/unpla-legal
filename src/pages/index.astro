---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCommerce, getVersions, pickCurrent } from '../lib/entries';
import { COMMERCE_PATH, formatDate } from '../utils';

// リンクハブ：各ドキュメントの最新版へ誘導する。
const terms = pickCurrent(await getVersions('terms'));
const privacy = pickCurrent(await getVersions('privacy'));
const commerce = await getCommerce();

const cards = [
  {
    href: '/terms',
    eyebrow: 'Terms of Service',
    title: terms.data.title,
    meta: `第${terms.data.version}版・効力発生日 ${formatDate(terms.data.effectiveDate)}`,
  },
  {
    href: '/privacy',
    eyebrow: 'Privacy Policy',
    title: privacy.data.title,
    meta: `第${privacy.data.version}版・効力発生日 ${formatDate(privacy.data.effectiveDate)}`,
  },
  ...(commerce
    ? [
        {
          href: COMMERCE_PATH,
          eyebrow: 'Commercial Disclosure',
          title: commerce.data.title,
          meta: `最終更新日 ${formatDate(commerce.data.updatedDate)}`,
        },
      ]
    : []),
  {
    href: '/support',
    eyebrow: 'Support',
    title: 'サポート',
    meta: 'お問い合わせ・不具合のご連絡',
  },
];
---

<BaseLayout path="/">
  <div class="container">
    <header class="page-hero hub-hero">
      <h1>UnplaQuest 法務情報</h1>
      <p class="lead">
        アンプラクエスト（UnplaQuest）をご利用いただくうえでの約束ごとと、情報の取り扱いについてまとめています。
      </p>
    </header>

    <ul class="cards">
      {
        cards.map((card) => (
          <li>
            <a class="card" href={card.href}>
              <span class="card-body">
                <span class="card-eyebrow">{card.eyebrow}</span>
                <span class="card-title">{card.title}</span>
                <span class="card-meta">{card.meta}</span>
              </span>
              <span class="card-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .hub-hero {
    padding-top: 4rem;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    max-width: 42rem;
  }
  .card {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.35rem 1.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .card:hover {
    color: var(--text);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }
  .card-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .card-meta {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .card-arrow {
    color: var(--text-faint);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }
  .card:hover .card-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-arrow {
      transition: none;
    }
    .card:hover,
    .card:hover .card-arrow {
      transform: none;
    }
  }
</style>
