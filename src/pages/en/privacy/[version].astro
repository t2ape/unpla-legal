---
import type { GetStaticPaths } from 'astro';
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { getVersions, renderEntry } from '../../../lib/entries';

// 各版を固定 URL（/en/privacy/v1 等）で生成する。一度公開したら URL を変えない。
export const getStaticPaths = (async () => {
  const entries = await getVersions('privacy', 'en');
  return entries.map((entry) => ({
    params: { version: entry.id },
    props: { entry, entries },
  }));
}) satisfies GetStaticPaths;

const { entry, entries } = Astro.props;
const { Content, headings } = await renderEntry(entry);
---

<LegalLayout kind="privacy" locale="en" entry={entry} entries={entries} headings={headings} isAlias={false}>
  <Content />
</LegalLayout>
