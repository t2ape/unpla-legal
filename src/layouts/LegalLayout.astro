---
import BaseLayout from './BaseLayout.astro';
import RevisionHistory from '../components/RevisionHistory.astro';
import type { Kind, LegalEntry } from '../lib/entries';
import { formatDate, KIND_LABEL } from '../utils';

interface Props {
  kind: Kind;
  // 表示中の版。
  entry: LegalEntry;
  // 公開対象の全版（version 降順）。改定履歴に使う。
  entries: LegalEntry[];
  // 最新版エイリアス（/terms・/privacy）として表示しているか。
  isAlias: boolean;
}

const { kind, entry, entries, isAlias } = Astro.props;
const { title, version, effectiveDate, status } = entry.data;
const label = KIND_LABEL[kind];
const pageTitle = isAlias ? title : `${title}（第${version}版）`;
const path = isAlias ? `/${kind}` : `/${kind}/v${version}`;
---

<BaseLayout pageTitle={pageTitle} breadcrumb={label} path={path}>
  <header class="doc-header">
    <h1>{title}</h1>
    <p class="meta">
      {status === 'current' ? `最新版（第${version}版）` : `第${version}版`}
      ・効力発生日：{formatDate(effectiveDate)}
    </p>
  </header>

  {
    status === 'past' && (
      <aside class="notice" role="note">
        これは過去版（第{version}版）です。
        <a href={`/${kind}`}>最新版はこちら</a>。
      </aside>
    )
  }
  {
    status === 'draft' && (
      <aside class="notice draft" role="note">
        下書き（第{version}版）です。開発サーバでだけ表示され、本番には公開されません。
      </aside>
    )
  }

  <article class="doc-body">
    <slot />
  </article>

  <RevisionHistory kind={kind} entries={entries} />
</BaseLayout>
