---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import RevisionHistory from '../components/RevisionHistory.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getJapaneseOnlyVersions, getVersions, type Kind, type LegalEntry } from '../lib/entries';
import { DEFAULT_LOCALE, otherLocale, UI, type Locale } from '../i18n';
import { localePath, PATHS, versionPath } from '../utils';

interface Props {
  kind: Kind;
  // ページの言語。entry・entries はこの言語のものを渡す。
  locale?: Locale;
  // 表示中の版。
  entry: LegalEntry;
  // 公開対象の全版（version 降順）。改定履歴に使う。
  entries: LegalEntry[];
  // 本文の見出し。目次に使う。
  headings: MarkdownHeading[];
  // 最新版エイリアス（/terms・/privacy）として表示しているか。
  isAlias: boolean;
}

const { kind, locale = DEFAULT_LOCALE, entry, entries, headings, isAlias } = Astro.props;
const t = UI[locale].legal;
const { title, version, effectiveDate, status } = entry.data;
const pastNotice = t.pastNotice(version);
const pageTitle = isAlias ? title : t.titleWithVersion(title, version);
const path = isAlias ? localePath(locale, PATHS[kind]) : versionPath(kind, version, locale);

// もう一方の言語の同じ版。最新版エイリアスどうしは必ず同じ版を返す（版の対応は getVersions が確かめている）。
// 英訳を作る前の過去版のように相手に同じ版が無いときは、対応なしにする。
const other = otherLocale(locale);
const otherEntries = await getVersions(kind, other);
const hasCounterpart = otherEntries.some((e) => e.data.version === version);
const alternatePath = !hasCounterpart
  ? undefined
  : isAlias
    ? localePath(other, PATHS[kind])
    : versionPath(kind, version, other);
// 英語の改定履歴に、日本語にだけある過去版（英訳を作る前の版）への案内を添える。
const japaneseOnly = locale === 'en' ? await getJapaneseOnlyVersions(kind) : [];
---

<BaseLayout locale={locale} pageTitle={pageTitle} path={path} alternatePath={alternatePath}>
  <div class="container">
    <header class="page-hero">
      <span class="eyebrow">{t.eyebrow[kind]}</span>
      <h1>{title}</h1>
      <div class="meta-row">
        {status === 'current' && <span class="chip is-accent">{t.latest}</span>}
        {status === 'draft' && <span class="chip is-warning">{t.draft}</span>}
        <span class="chip">{t.version(version)}</span>
        <span class="chip">{t.effective(effectiveDate)}</span>
      </div>
    </header>

    <div class="doc-grid">
      <div class="doc-main">
        {
          status === 'past' && (
            <aside class="notice" role="note">
              {pastNotice.before}
              <a href={localePath(locale, PATHS[kind])}>{pastNotice.link}</a>
              {pastNotice.after}
            </aside>
          )
        }
        {
          status === 'draft' && (
            <aside class="notice draft" role="note">
              {t.draftNotice(version)}
            </aside>
          )
        }
        {
          // 日本語が正本で、英語は参考訳。英語の規約・PP には、どの版にも冒頭にこの注記を必ず出す
          // （リンク先を作れるかどうかに左右させない）。リンク先は日本語の同じ版。
          t.translationNotice && (
            <aside class="notice translation" role="note">
              {t.translationNotice.before}
              <a href={alternatePath ?? versionPath(kind, version, 'ja')} hreflang="ja">
                {t.translationNotice.link}
              </a>
              {t.translationNotice.after}
            </aside>
          )
        }

        <TableOfContents headings={headings} variant="inline" locale={locale} />

        <article class="prose">
          <slot />
        </article>

        <RevisionHistory
          kind={kind}
          locale={locale}
          entries={entries}
          currentVersion={version}
          japaneseOnly={japaneseOnly}
        />
      </div>

      <TableOfContents headings={headings} variant="sidebar" locale={locale} />
    </div>
  </div>
</BaseLayout>

<style>
  /* お知らせが続くとき（下書き＋参考訳の注記など）は間を詰める。 */
  .notice:has(+ .notice) {
    margin-bottom: 0.75rem;
  }
  .doc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 1040px) {
    .doc-grid {
      grid-template-columns: minmax(0, 42rem) 15rem;
      justify-content: space-between;
      gap: 4rem;
    }
  }
</style>
