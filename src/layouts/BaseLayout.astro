---
// 法務ドキュメント・サポート等、トップ以外のページの共通の枠。
interface Props {
  // <title> の「| UnplaQuest」より前。
  pageTitle: string;
  // パンくずの末尾に出すページ名。
  breadcrumb: string;
  // canonical のパス。
  path: string;
}

const { pageTitle, breadcrumb, path } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} | UnplaQuest</title>
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <main>
      <nav class="breadcrumb">
        <a href="/">UnplaQuest 法務情報</a>
        <span aria-hidden="true">/</span>
        <span>{breadcrumb}</span>
      </nav>

      <slot />

      <footer class="site-footer">
        <a href="/">← 法務情報トップ</a>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --text: #1a1a1a;
    --text-muted: #6b7280;
    --border: #e5e7eb;
    --accent: #2563eb;
    --accent-soft: #eff6ff;
    --warning-soft: #fef3c7;
    --max-width: 46rem;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115;
      --text: #e8e8ea;
      --text-muted: #9aa0a6;
      --border: #2a2d34;
      --accent: #6ea8fe;
      --accent-soft: #1a2233;
      --warning-soft: #3a2f12;
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    color-scheme: light dark;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Noto Sans JP',
      'Helvetica Neue', Arial, sans-serif;
    line-height: 1.85;
    font-size: 16px;
    -webkit-text-size-adjust: 100%;
  }
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }
  a {
    color: var(--accent);
    text-underline-offset: 2px;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .doc-header h1 {
    font-size: 1.8rem;
    margin: 0 0 0.5rem;
  }
  .doc-header .meta {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .notice {
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: var(--accent-soft);
    font-size: 0.9rem;
  }
  .notice.draft {
    background: var(--warning-soft);
  }
  .doc-body {
    margin-top: 2.5rem;
  }
  .doc-body h2 {
    font-size: 1.25rem;
    margin-top: 2.5rem;
    padding-top: 0.5rem;
  }
  .doc-body h3 {
    font-size: 1.05rem;
    margin-top: 1.75rem;
  }
  .doc-body ol,
  .doc-body ul {
    padding-left: 1.5rem;
  }
  .doc-body li {
    margin: 0.35rem 0;
  }
  .doc-body a {
    word-break: break-all;
  }
  .site-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
</style>
