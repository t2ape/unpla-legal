---
import type { Kind, LegalEntry } from '../lib/entries';
import { DEFAULT_LOCALE, UI, type Locale } from '../i18n';
import { versionPath } from '../utils';

interface Props {
  kind: Kind;
  locale?: Locale;
  // 公開対象の全版（version 降順で渡す）。
  entries: LegalEntry[];
  // 表示中の版。
  currentVersion: number;
  // 英語のページでだけ使う。日本語にだけある版（英訳を作る前の版）。
  japaneseOnly?: LegalEntry[];
}

const { kind, locale = DEFAULT_LOCALE, entries, currentVersion, japaneseOnly = [] } = Astro.props;
const t = UI[locale].legal;
---

<section class="revision-history" aria-labelledby="revision-history-heading">
  <h2 id="revision-history-heading">{t.history}</h2>
  <ol>
    {
      entries.map((entry) => {
        const { version, effectiveDate, status } = entry.data;
        const isViewing = version === currentVersion;
        return (
          <li class:list={{ 'is-viewing': isViewing }}>
            <a href={versionPath(kind, version, locale)} aria-current={isViewing ? 'true' : undefined}>
              <span class="version">{t.version(version)}</span>
              <span class="date">{t.effective(effectiveDate)}</span>
              {status === 'current' && <span class="badge">{t.latest}</span>}
              {status === 'draft' && <span class="badge is-draft">{t.draft}</span>}
            </a>
          </li>
        );
      })
    }
  </ol>
  {
    t.japaneseOnlyVersions && japaneseOnly.length > 0 && (
      <p class="japanese-only">
        {t.japaneseOnlyVersions.lead}
        {japaneseOnly.map((entry, i) => (
          <>
            {i > 0 && t.japaneseOnlyVersions?.separator}
            <a href={versionPath(kind, entry.data.version, 'ja')} hreflang="ja">
              {t.version(entry.data.version)}
            </a>
          </>
        ))}
      </p>
    )
  }
</section>

<style>
  .revision-history {
    margin-top: 4.5rem;
    max-width: 42rem;
  }
  h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    margin: 0 0 1rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    overflow: hidden;
  }
  li + li {
    border-top: 1px solid var(--border);
  }
  ol a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    padding: 0.85rem 1.15rem;
    color: var(--text);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  ol a:hover {
    background: var(--surface-muted);
    color: var(--text);
  }
  .japanese-only {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .japanese-only a {
    white-space: nowrap;
  }
  .is-viewing a {
    background: var(--accent-soft);
  }
  .version {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .date {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .badge {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.05rem 0.6rem;
    border-radius: 999px;
    color: var(--accent);
    background: var(--accent-soft);
  }
  .is-viewing .badge {
    background: var(--surface);
  }
  .badge.is-draft {
    color: var(--warning-text);
    background: var(--warning-soft);
  }
</style>
