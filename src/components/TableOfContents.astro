---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  // inline = 狭い画面で本文の前に折りたたみで出す / sidebar = 広い画面で右に固定で出す。
  variant: 'inline' | 'sidebar';
}

const { headings, variant } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 0 &&
    (variant === 'inline' ? (
      <details class="toc-inline">
        <summary>目次</summary>
        <ol>
          {items.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    ) : (
      <nav class="toc-sidebar" aria-label="目次">
        <p class="toc-title">目次</p>
        <ol>
          {items.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    ))
}

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: block;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    line-height: 1.55;
  }
  a:hover {
    color: var(--accent);
  }

  .toc-inline {
    margin: 0 0 2.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }
  .toc-inline summary {
    cursor: pointer;
    padding: 0.8rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .toc-inline summary::-webkit-details-marker {
    display: none;
  }
  .toc-inline summary::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s ease;
  }
  .toc-inline[open] summary::after {
    transform: rotate(-135deg) translateY(-2px);
  }
  .toc-inline ol {
    padding: 0 1.1rem 0.9rem;
    border-top: 1px solid var(--border);
  }
  .toc-inline li a {
    padding: 0.45rem 0;
  }

  .toc-sidebar {
    display: none;
  }
  @media (min-width: 1040px) {
    .toc-inline {
      display: none;
    }
    .toc-sidebar {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
      max-height: calc(100vh - var(--header-h) - 4rem);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--border-strong) transparent;
      padding-left: 1.25rem;
      border-left: 1px solid var(--border);
    }
    .toc-title {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      color: var(--text-faint);
      margin: 0 0 0.75rem;
    }
    .toc-sidebar li a {
      padding: 0.3rem 0;
    }
  }
</style>
